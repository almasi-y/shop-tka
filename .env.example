NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Server-only, comma-separated exact email addresses allowed to open /admin.
# An empty value denies admin access to every account.
ADMIN_EMAIL_ALLOWLIST=admin@example.com

NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-04
SANITY_API_READ_TOKEN=your_sanity_viewer_token
# Must be a separate server-only token with Editor permissions. Viewer tokens
# cannot persist carts, wishlists, restock subscriptions, orders, or returns.
SANITY_API_WRITE_TOKEN=your_sanity_write_token

PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Random server-only values of at least 32 characters. Configure both in
# Vercel Production, then redeploy. Never expose them to browser code.
PAYMENT_OPERATIONS_SECRET=replace_with_a_long_random_secret
CRON_SECRET=replace_with_a_different_long_random_secret
# Optional HTTPS endpoint for sanitized payment failure alerts (for example,
# a Slack-compatible incoming webhook). Failures are always logged even when
# this is not configured.
PAYMENT_ALERT_WEBHOOK_URL=

# Required for local Vercel AI Gateway usage. Vercel deployments may use OIDC.
AI_GATEWAY_API_KEY=your_ai_gateway_key
# Keep disabled until AI Gateway credits and the Anthropic model are available.
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=false
